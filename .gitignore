target/
# The wheel for pyodide that scripts/build_pyodide_wheel.sh leaves, and the
# JavaScript that the TypeScript compiler leaves in js/popnei/dist/.
dist/
.venv/
__pycache__/
*.pyc
# The module that `maturin develop` compiles and leaves beside the Python
# package: popnei/_core.cpython-<version>-<platform>.so.
python/popnei/_core*.so
# The dependencies that npm installs for the TypeScript package and for the
# smoke test of pyodide, which the `package-lock.json` beside each of the
# two says which versions of.
node_modules/
# The JavaScript, the declarations and the wasm that the `wasm-bindgen`
# command line generates from the build of crates/popnei-js. What the
# TypeScript compiler leaves, js/popnei/dist/, is under the `dist/` above.
js/popnei/wasm/
# The copy of LICENSE that the `prepack` script of js/popnei puts beside
# `package.json`, because npm packs the files of the package directory and
# LICENSE is at the root of the repository. It is written again before
# every `npm pack`, so it cannot drift from the file it is copied from, and
# a second copy in git could.
js/popnei/LICENSE
tmp/
.claude/worktrees/
# What Playwright leaves for a browser test that failed, the screenshot
# and the trace of `js/popnei/test/browser/`, which `playwright.config.ts`
# runs.
js/popnei/test-results/
# The messages that sessions working at the same time leave for each other,
# described in .claude/board/README.md. They live outside the branches so
# that a session on one branch sees what a session on another posted, and
# only the README is in git.
.claude/board/*
!.claude/board/README.md
